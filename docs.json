{
  "$schema": "https://mintlify.com/docs.json",
  "name": "ParleHub",
  "theme": "mint",
  "favicon": {
    "light": "/images/apple-touch-icon.png",
    "dark": "/images/apple-touch-icon.png"
  },
  "colors": {
    "primary": "#4d8eff",
    "light": "#87b0fb"
  },
  "fonts": {
    "heading": {
      "family": "Fraunces"
    },
    "body": {
      "family": "Inter"
    }
  },
  "appearance": {
    "default": "system"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Start Free Trial",
      "href": "https://app.parlehub.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "plans-and-billing"
            ]
          },
          {
            "group": "Projects & Collaboration",
            "pages": [
              "projects/overview",
              "projects/conversations",
              "projects/shared-context",
              "projects/file-tools"
            ]
          },
          {
            "group": "Cost Management",
            "pages": [
              "cost/budgets",
              "cost/expense-codes",
              "cost/usage-analytics"
            ]
          },
          {
            "group": "AI Models",
            "pages": [
              "models/connecting-providers",
              "models/supported-models",
              "models/model-selection"
            ]
          },
          {
            "group": "Tools & Knowledge",
            "icon": "toolbox",
            "pages": [
              "tools/integrations",
              "tools/confluence",
              "tools/integration-scopes",
              "knowledge/organization-knowledge",
              "knowledge/asking-about-your-org",
              "tools/my-integrations"
            ]
          },
          {
            "group": "Security & Governance",
            "pages": [
              "security/overview",
              "security/sso",
              "security/storage",
              "security/audit-log",
              "security/roles-and-permissions"
            ]
          },
          {
            "group": "Administration",
            "pages": [
              "admin/organization-setup",
              "admin/managing-members",
              "admin/org-caps",
              "admin/microsoft-365",
              "admin/google-workspace"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://www.parlehub.com"
    }
  },
  "description": "Learn what ParleHub is, why it was built for professional services firms, and how it solves AI cost allocation, collaboration, and governance.",
  "logo": {
    "light": "/images/pwa-215x215.png",
    "dark": "/images/pwa-215x215.png"
  },
  "redirects": [
    {
      "source": "/tools/mcp-tools",
      "destination": "/tools/integrations",
      "permanent": true
    }
  ]
}
